# ==== Database (PostgreSQL) ====
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ==== Auth (NextAuth) ====
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Absolute URL used in email links (defaults to NEXTAUTH_URL).
# APP_URL=http://192.168.100.248:3000

# Branding shown in emails and page titles
APP_NAME=Root2Tech

# ==== Client base path ====
# Keep empty when the backend runs at a domain/subdomain root.
NEXT_PUBLIC_BASE_PATH=

# ==== Google OAuth (optional) ====
# Provider is enabled automatically when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==== SMTP (optional) ====
# When SMTP_HOST is empty, all emails (verification, reset, invites) are
# printed to the server console with their links instead of being sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=Root2Tech
SMTP_FROM=no-reply@root2tech.com

# ==== Google reCAPTCHA v2 (optional) ====
# When unset, signup/reset skip captcha on both client and server.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ==== File storage (optional, avatars/uploads) ====
STORAGE_TYPE=digitalocean
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CDN_URL=
